<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<!-- Main Window -->
<BorderPane prefHeight="1080"
            prefWidth="1920"
            styleClass="app"
            stylesheets="@themes/dark.css"
            xmlns="http://javafx.com/javafx/26">

    <center>
        <VBox alignment="CENTER" spacing="40.0" styleClass="login-page">

            <!-- Page title -->
            <Label text="Pokemon Card Collection" styleClass="login-title" />

            <StackPane>
                <ImageView fitWidth="250.0"
                           fitHeight="200.0"
                           preserveRatio="true"
                           opacity="0.9"
                           translateY="300.0"
                           mouseTransparent="true">
                    <image>
                        <Image url="@database/pokedex/025.png" />
                    </image>
                </ImageView>

                <VBox alignment="CENTER_LEFT"
                      spacing="12.0"
                      styleClass="login-card">
                    <Label text="Register your account" styleClass="login-heading" />

                    <!-- Username -->
                    <VBox spacing="4.0">
                        <Label text="Username *" styleClass="login-field-label" />
                        <TextField promptText="Enter a username" styleClass="login-field" />
                    </VBox>

                    <!-- Password -->
                    <VBox spacing="4.0">
                        <Label text="Password *" styleClass="login-field-label" />
                        <PasswordField promptText="Enter a password" styleClass="login-field" />
                    </VBox>

                    <!-- Password Confirm -->
                    <VBox spacing="4.0">
                        <Label text="Confirm password *" styleClass="login-field-label" />
                        <PasswordField promptText="Confirm your password" styleClass="login-field" />
                    </VBox>

                    <!-- Registration -->
                    <Button maxWidth="Infinity"
                            text="Register"
                            styleClass="login-button" />

                    <!-- Link to Sign In -->
                    <HBox alignment="CENTER" spacing="3.0">
                        <Label text="Already have an account?" styleClass="register-text" />
                        <Hyperlink text="Login" styleClass="register-link" />
                    </HBox>
                </VBox>
            </StackPane>
        </VBox>
    </center>
</BorderPane>
