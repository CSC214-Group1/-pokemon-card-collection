<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Main Window -->
<BorderPane prefHeight="1080"
            prefWidth="1920"
            styleClass="app"
            stylesheets="@themes/dark.css"
            xmlns="http://javafx.com/javafx/26">

    <!-- Sidebar -->
    <left>
        <VBox alignment="TOP_CENTER"
              prefWidth="200"
              spacing="16.0"
              styleClass="sidebar">
            <padding>
                <Insets bottom="20.0" left="10.0" right="10.0" top="75" />
            </padding>

            <!-- Profile Picture -->
            <ImageView fitWidth="100.0"
                       fitHeight="76.0"
                       preserveRatio="true"
                       smooth="true">
                <image>
                    <Image url="@database/profile.png" />
                </image>
            </ImageView>

            <Label styleClass="profile-name" text="Ash Ketchum" />

            <Region minHeight="100.0" prefHeight="100.0" maxHeight="100.0" />

            <!-- Sidebar Navigation -->
            <VBox alignment="CENTER" spacing="2.0" styleClass="navigation">
                <Button prefWidth="200"
                        styleClass="nav-item"
                        text="Collection (1)" />
                <Button prefWidth="200"
                        styleClass="nav-item, nav-selected"
                        text="Collection (2)" />
                <Button prefWidth="200"
                        styleClass="nav-item"
                        text="+ Add Collection" />
                <Button prefWidth="200"
                        styleClass="nav-item"
                        text="⚙ Settings" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />
        </VBox>
    </left>

    <!-- Dashboard Below -->
    <center>
        <VBox spacing="18.0" styleClass="dashboard">
            <padding>
                <Insets bottom="22.0" left="18.0" right="30.0" top="22.0" />
            </padding>

            <!-- Collection Value -->
            <HBox alignment="TOP_LEFT" spacing="24.0">
                <VBox prefWidth="390.0" spacing="-4.0">
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="currency-symbol" text="\$" />
                        <Label styleClass="total-value" text="???" />
                        <Label styleClass="cents" text=".??" />
                    </HBox>
                    <Label styleClass="total-caption" text="TOTAL COLLECTION VALUE" />
                </VBox>

                <!-- Spacer for chart -->
                <Region HBox.hgrow="ALWAYS" />

                <!-- Chart -->
                <BarChart animated="false"
                          legendVisible="false"
                          prefHeight="145.0"
                          prefWidth="310.0"
                          styleClass="collection-chart"
                          title="Collection (2)">
                    <xAxis>
                        <CategoryAxis animated="false" side="BOTTOM" />
                    </xAxis>
                    <yAxis>
                        <NumberAxis animated="false"
                                    lowerBound="0.0"
                                    side="LEFT"
                                    tickUnit="40.0"
                                    upperBound="160.0" />
                    </yAxis>
                </BarChart>
            </HBox>

            <!-- Sort/Add -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Button styleClass="toolbar-button" text="Sort By [L..]" />
                <Button styleClass="toolbar-button" text="Add Card" />
            </HBox>

            <!-- Cards -->
            <HBox spacing="12.0">

                <!-- Pidgeotto card -->
                <VBox spacing="8.0" styleClass="pokemon-card">
                    <HBox alignment="CENTER_RIGHT" spacing="4.0">
                        <Button styleClass="edit-badge" text="E" />
                        <Button styleClass="delete-badge" text="D" />
                    </HBox>
                    <Label styleClass="pokemon-name" text="Pidgeotto" />
                    <ImageView fitWidth="100.0"
                               fitHeight="76.0"
                               preserveRatio="true"
                               smooth="true">
                        <image>
                            <Image url="@database/pokedex/017.png" />
                        </image>
                    </ImageView>
                    <Label styleClass="type-label" text="Normal   Flying" />
                    <Label styleClass="stat" text="HP 63     ATK 60     DEF 55" />
                    <Label styleClass="stat" text="SP.ATK 50   SP.DEF 50   SPD 71" />
                </VBox>

                <!-- Porygon2 card -->
                <VBox spacing="8.0" styleClass="pokemon-card">
                    <HBox alignment="CENTER_RIGHT" spacing="4.0">
                        <Button styleClass="edit-badge" text="E" />
                        <Button styleClass="delete-badge" text="D" />
                    </HBox>
                    <Label styleClass="pokemon-name" text="Porygon2" />
                    <ImageView fitWidth="100.0"
                               fitHeight="76.0"
                               preserveRatio="true"
                               smooth="true">
                        <image>
                            <Image url="@database/pokedex/233.png" />
                        </image>
                    </ImageView>
                    <Label styleClass="type-label" text="Normal" />
                    <Label styleClass="stat" text="HP 85     ATK 80     DEF 90" />
                    <Label styleClass="stat" text="SP.ATK 105    SP.DEF 95    SPD 60" />
                </VBox>

                <!-- Azumarill card -->
                <VBox spacing="8.0" styleClass="pokemon-card">
                    <HBox alignment="CENTER_RIGHT" spacing="4.0">
                        <Button styleClass="edit-badge" text="E" />
                        <Button styleClass="delete-badge" text="D" />
                    </HBox>
                    <Label styleClass="pokemon-name" text="Azumarill" />
                    <ImageView fitWidth="100.0"
                               fitHeight="76.0"
                               preserveRatio="true"
                               smooth="true">
                        <image>
                            <Image url="@database/pokedex/184.png" />
                        </image>
                    </ImageView>
                    <Label styleClass="type-label" text="Water   Fairy" />
                    <Label styleClass="stat" text="HP 100     ATK 50     DEF 80" />
                    <Label styleClass="stat" text="SP.ATK 60   SP.DEF 80   SPD 50" />
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
