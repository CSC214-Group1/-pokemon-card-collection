<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Main Window -->
<BorderPane prefHeight="1080"
            prefWidth="1920"
            styleClass="app"
            stylesheets="@themes/dark.css"
            xmlns="http://javafx.com/javafx/26">

    <!-- Sidebar -->
    <left>
        <VBox alignment="TOP_CENTER" prefWidth="200" spacing="16.0" styleClass="sidebar">
            <padding>
                <Insets bottom="20.0" left="10.0" right="10.0" top="75" />
            </padding>

            <!-- Profile Picture -->
            <ImageView fitWidth="100.0" fitHeight="76.0" preserveRatio="true" smooth="true">
                <image>
                    <Image url="@database/profile.png"/>
                </image>
            </ImageView>
            <Label styleClass="profile-name" text="Ash Ketchum" />

            <Region minHeight="100.0" prefHeight="100.0" maxHeight="100.0" />

            <!-- Sidebar Navigation -->
            <VBox alignment="CENTER" spacing="2.0" styleClass="navigation">
                <Button prefWidth="200"
                        styleClass="nav-item"
                        text="Collection (1)" />
                <Button prefWidth="200"
                        styleClass="nav-item, nav-selected"
                        text="Collection (2)" />
                <Button prefWidth="200"
                        styleClass="nav-item"
                        text="+ Add Collection" />
                <Button prefWidth="200"
                        styleClass="nav-item"
                        text="⚙ Settings" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />
        </VBox>
    </left>

    <center>
        <VBox alignment="TOP_LEFT"
              spacing="12.0"
              styleClass="settings-content">
            <padding>
                <Insets top="37.0" right="20.0" bottom="20.0" left="80.0" />
            </padding>

            <!-- Username Change -->
            <HBox alignment="CENTER" spacing="16.0">
                <Label text="Username: Ash Ketchum"
                       styleClass="setting-value"
                       prefWidth="250.0" />
                <Button text="Change" styleClass="setting-button" />
            </HBox>

            <!-- Password Change -->
            <HBox alignment="CENTER" spacing="16.0">
                <Label text="Password: ********"
                       styleClass="setting-value"
                       prefWidth="250.0" />
                <Button text="Change" styleClass="setting-button" />
            </HBox>

            <!-- Theme Change -->
            <HBox alignment="CENTER" spacing="16.0">
                <Label text="UI Mode: Dark"
                       styleClass="setting-value"
                       prefWidth="250.0" />
                <Button text="Change" styleClass="setting-button" />
            </HBox>

            <!-- Profile Picture Change -->
            <HBox alignment="CENTER" spacing="16.0">
                <Label text="Profile Picture:"
                       styleClass="setting-value"
                       prefWidth="250.0" />
                <Button text="Change" styleClass="setting-button" />
            </HBox>

            <!-- Current Profile Picture -->
            <HBox alignment="CENTER">
                <ImageView fitWidth="80.0"
                           fitHeight="80.0"
                           preserveRatio="true"
                           smooth="true">
                    <image>
                        <Image url="@database/profile.png" />
                    </image>
                </ImageView>
            </HBox>
        </VBox>
    </center>
</BorderPane>
